# --- HubSpot OAuth Configuration (For Browser Login) ---
HUBSPOT_CLIENT_ID=your_client_id_here
HUBSPOT_CLIENT_SECRET=your_client_secret_here
HUBSPOT_REDIRECT_URI=http://localhost:6274/oauth/callback/debug

# --- OR HubSpot Private App Token (Alternative static token) ---
# If you set this, OAuth browser login is bypassed and this token is used directly.
# HUBSPOT_PRIVATE_APP_TOKEN=pat-na1-xxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
